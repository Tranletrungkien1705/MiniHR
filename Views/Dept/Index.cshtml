@model List<Department>
@{ ViewData["Title"] = "Phòng ban"; var counts = (Dictionary<int,int>)ViewBag.Counts; }
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Mã</th><th>Tên phòng ban</th><th class="text-end">Số NV</th></tr></thead>
            <tbody>
            @foreach (var d in Model)
            {
                <tr><td class="fw-semibold">@d.Code</td><td>@d.Name</td><td class="text-end">@(counts.TryGetValue(d.Id, out var c) ? c : 0)</td></tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-4">Chưa có phòng ban.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Thêm phòng ban</h6>
        <form asp-action="Create" method="post">@Html.AntiForgeryToken()
            <div class="mb-2"><input name="code" class="form-control" placeholder="Mã (vd KD)" /></div>
            <div class="mb-3"><input name="name" class="form-control" placeholder="Tên phòng ban" required /></div>
            <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Thêm</button>
        </form>
    </div></div></div>
</div>
